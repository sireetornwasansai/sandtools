# ───────── Frontend (Vercel → Project → Settings → Environment Variables) ─────────
# These are PUBLIC values: they are written into dist/config.js and visible to every visitor.
# Never put secrets here.

# URL of the deployed Google Apps Script web app (ends with /exec)
SAND_GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# OAuth 2.0 *Web* client ID (public by design)
SAND_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# true = users must sign in with Google before using the app
SAND_REQUIRE_LOGIN=true
# Optional — only for "Open from Google Drive" (Google Picker)
SAND_GOOGLE_API_KEY=
SAND_GOOGLE_APP_ID=
# Limits (client-side converter)
SAND_MAX_FILE_SIZE_MB=25
SAND_CONVERSION_TIMEOUT_SEC=60

# ───────── Backend (Google Apps Script → Project Settings → Script properties) ─────────
# These are entered in the Apps Script UI, NOT in Vercel and NOT in Git. Listed here as documentation.
#   GOOGLE_CLIENT_ID       same Web client ID as above
#   ALLOWED_EMAIL_DOMAIN   e.g. example.go.th   (comma-separate for several; empty = any Google account)
#   ALLOWED_EMAILS         optional exceptions, comma-separated
#   SESSION_SECRET         generated automatically by running setup() once
#   SESSION_TTL_MIN        optional, default 480
#   LOGIN_LIMIT_PER_MIN    optional, default 30
