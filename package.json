{
  "name": "sand-office-tools",
  "version": "1.0.0",
  "description": "SAND Office Tools — Personal & Office Utility Platform (Sansai Administration Network)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "ocr:fetch": "node scripts/fetch-ocr.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -p jsconfig.json",
